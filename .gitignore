.vercel
.DS_Store

# Incoming source package: the supplied ZIP and its extraction.
# Kept locally as the delivered original; never committed and never served.
new-website/

# Build output. Regenerated by site/build.py on every deploy.
site/dist/
site/dist-production/
site/dillon-agency-website.html

# Local-only asset tooling: install with `cd site/tools && npm install`.
site/tools/node_modules

# Python bytecode from the builder.
__pycache__/
*.pyc
